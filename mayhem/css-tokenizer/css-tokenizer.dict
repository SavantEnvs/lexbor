# libFuzzer dictionary for the css-tokenizer target.
# Merged from BOTH upstream dictionaries, deduplicated by value:
#   test/fuzzers/lexbor/css/syntax/syntax.dict  (41 entries — tokenizer-level tokens)
#   test/fuzzers/lexbor/css/css.dict            (297 entries — CSS property/selector/at-rule vocabulary)
# Previously only syntax.dict was wired, leaving css.dict — the larger and more
# semantically useful of the two — unused. Only \\, \" and \xHH escapes appear (a literal
# \n would abort dict parsing before the first input, silently disabling fuzzing).
syntax_comment="/* comment */"
syntax_whitespace="\x0A\x0D\x0D\x0A\x0C\x09\x20"
syntax_string_1="'string'"
syntax_string_2="\"string\""
syntax_hash="#hash"
syntax_left_parenthesis="("
syntax_right_parenthesis=")"
syntax_plus="+"
syntax_number_plus_1="+1"
syntax_number_plus_2="+1.1"
syntax_number_plus_3="+1.1e-2"
syntax_comma=","
syntax_minus="-"
syntax_number_minus_1="-1"
syntax_number_minus_2="-1.1"
syntax_number_minus_3="-1.1e-2"
syntax_cdc="-->"
syntax_ident_start_minus_1="-ident"
syntax_ident_start_minus_2="--ident"
syntax_ident_start_minus_3="---"
syntax_ident_start_minus_4="\\47\\72"
syntax_full_stop="."
syntax_number_full_stop_1=".1"
syntax_number_full_stop_2=".1e-2"
syntax_colon=":"
syntax_semicolon=";"
syntax_less_than_sign="<"
syntax_cdo="<!--"
syntax_at="@"
syntax_at_keyword_1="@at"
syntax_at_keyword_2="@\\47\\72"
syntax_reverse_solidus="\\"
syntax_left_square_bracket="["
syntax_right_square_bracket="]"
syntax_left_curly_bracket="{"
syntax_right_curly_bracket="}"
syntax_number="12345"
syntax_delim_1="$"
syntax_delim_2="^"
syntax_delim_3="\xFF"
syntax_delim_4="\x80"
css_declr_name="width:"
css_declr_value="width: 100%"
css_declr_important="!important"
css_after="::after"
css_before="::before"
css_first_letter="::first-letter"
